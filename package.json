{
  "name": "@thilakbhat/heatmap-ui",
  "version": "0.2.0",
  "description": "A headless heatmap toolkit for React. Any grid, eight cell shapes, a 3D SVG mode, and full control of colour, size and layout.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./static-svg": {
      "types": "./dist/static-svg.d.ts",
      "import": "./dist/static-svg.js",
      "default": "./dist/static-svg.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE",
    "docs/cover.png",
    "docs/playground-2d.png",
    "docs/playground-3d.png"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/tb962/heatmap-ui.git" },
  "homepage": "https://tb962.github.io/heatmap-ui/",
  "bugs": { "url": "https://github.com/tb962/heatmap-ui/issues" },
  "author": "tb962",
  "keywords": [
    "heatmap", "react", "calendar-heatmap", "contribution-graph", "punchcard",
    "hexbin", "data-visualization", "grid", "accessible", "headless",
    "3d", "isometric", "svg", "themeable", "quantile"
  ],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
